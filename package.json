{
  "name": "orbit-personal-intelligence",
  "version": "0.2.0",
  "description": "ORBIT \u2014 a local-first personal intelligence workspace",
  "main": "src/main.js",
  "author": "ORBIT",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package:linux": "electron-builder --linux dir",
    "package:mac": "electron-builder --mac dir"
  },
  "dependencies": {
    "openai": "^5.16.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.orbit.personalintelligence",
    "productName": "ORBIT",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}